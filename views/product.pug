extends layout
include mixins/icones

block stylesheets
  link(rel="stylesheet", href="/stylesheets/product.css")
  if embed
    //- Mode overlay : en-tête de modale épuré (le titre n'est plus une carte),
    //- contenu pleine largeur, espacements resserrés. Le panneau opaque de
    //- l'overlay fournit le fond ; la page devient transparente.
    style.
      html, body { background: transparent !important; }
      .main-container {
        max-width: none;
        width: 100%;
        margin: 0;
        padding: 18px 22px 22px;
        min-height: 0;
      }
      /* Titre : simple en-tête */
      #title-container {
        background: transparent;
        padding: 0;
        margin-bottom: 8px;
        min-height: 0;
      }
      /* seule la 1re ligne (fil d'Ariane) doit éviter le bouton × */
      #breadcrumb { padding-right: 44px; }
      .header-title h1 { font-size: 22px; margin: 4px 0 8px; }
      .productpg-status-row { margin-bottom: 0; max-width: none; }
      /* Cartes : respiration réduite */
      .productpg-timeline-card,
      .productpg-sales-card {
        padding: 18px 20px;
        margin-top: 12px;
      }

block scripts
  script(type='module', src='/js/draw_product_page.js')

//- embed=1 : page affichée dans l'overlay de la liste -> ni barre ni bouton,
//- l'apparence suit celle de la page qui l'affiche (apparence.js).
block barre
  if !embed
    +barre()

block content
  .main-container
    #title-container.flex-container
      .header-title
        #breadcrumb
        h1
          #productpg-report-title
        .productpg-status-row
          //- Icône et couleur remplacées par draw_product_page.js selon le statut
          span.productpg-status-icon
            +icone('square-xmark', 'rupture-icon')
          span.productpg-status-label Statut actuel :
          //- Rempli par drawSubstitutesCard() : « · 5 substituts disponibles »
          span.productpg-status-substitutes#productpg-status-substitutes

    .flex-container
      .productpg-inner-wrapper
        .cis-list#cis-list
        #productpg-stats
    
    .productpg-sales-card#productpg-ansm-card(style="display:none")
    .productpg-sales-card#productpg-sales-card
    .productpg-timeline-card
      h2.card-title Historique des incidents
      #productpg-timeline-container
    
    //- h2.section-title Alternatives thérapeutiques
    //- #alternatives-navigation-container.ema-incident-card
    //-   form#alternatives-form
    //-     label(for="cis-selector") Choisir un code CIS pour voir les alternatives :
    //-     select#cis-selector(name="cis")
    //-     button(type="submit") Voir les alternatives

    .ema-incident-card
      h2.card-title Incidents au niveau européen (EMA) liés
      #ema-incidents

block head
  script.
    window.productId = !{JSON.stringify(productId)};
    window.globalReportDate = !{JSON.stringify(globalReportDate)};